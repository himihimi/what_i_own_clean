# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …but the template carries no values and documents what is needed.
!.env.example

# uploaded item images (local only)
/uploads

# prisma sqlite database
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# working drafts and mockups — local only, superseded by docs/architecture.md and docs/design.md
/docs/*_DRAFT.md
/docs/*_draft.md
/docs/todos
/scratchpad
